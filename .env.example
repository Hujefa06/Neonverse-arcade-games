# ==============================================================================
# NEONVERSE ARCADE: Environment Variables
# If Supabase variables are left blank or omitted, Neonverse Arcade automatically
# activates the Local Mock Adapter (providing full guest saves, local leaderboards,
# and offline gameplay with zero setup needed).
# ==============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API Configuration
PORT=3001
VITE_API_BASE_URL=http://localhost:3001

# Production flags
NODE_ENV=development
